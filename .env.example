# =============================================================================
# AOP environment template — copy to .env and fill in real values.
# .env is gitignored; NEVER commit real secrets.
# =============================================================================

# ---- PostgreSQL (docker-compose.yml + db/migrate.mjs + ingestion) -----------
POSTGRES_USER=aop
POSTGRES_PASSWORD=aop
POSTGRES_DB=aop
# Connection string used by `npm run migrate` (db/) and the ingestion service.
DATABASE_URL=postgres://aop:aop@localhost:5432/aop

# ---- Ingestion service (services/ingestion) ---------------------------------
# Bearer token the edge queue consumer presents on POST /ingest/telemetry.
# Generate a real one: openssl rand -hex 32
INGEST_API_TOKEN=dev-token
# Shopify app webhook signing secret (Shopify admin -> notifications/webhooks).
SHOPIFY_WEBHOOK_SECRET=dev-secret
# Optional knobs (defaults shown):
#PORT=8787
#INTENT_EXPIRY_SECONDS=60
#LOSS_SWEEP_INTERVAL_MS=15000
# Bearer token for the dashboard's read-only /analytics routes. OPTIONAL:
# leave unset to disable analytics entirely (routes answer 503).
# Generate: openssl rand -hex 32
DASHBOARD_API_TOKEN=dev-dash-token
# CORS origin reflected on /analytics/* (default '*'; pin to the dashboard's
# real origin in production).
#DASHBOARD_ALLOWED_ORIGIN=*

# ---- Merchant onboarding: Shopify OAuth install flow (all four or none) -----
# From your Shopify Partner app credentials:
#SHOPIFY_API_KEY=
#SHOPIFY_API_SECRET=
# AES-256-GCM key for encrypting merchant access tokens at rest.
# Generate: openssl rand -hex 32
#TOKEN_ENCRYPTION_KEY=
# Public base URL of THIS ingestion service (OAuth redirect + webhook address).
#APP_URL=https://ingest.aop.network

# ---- Optimizer microservice (optimizer/aop_optimizer/server.py) -------------
# Bind address for `python3 -m aop_optimizer.server` (dashboard Data Optimizer
# tab talks to it). Defaults shown.
#AOP_OPTIMIZER_HOST=127.0.0.1
#AOP_OPTIMIZER_PORT=8899

# ---- Edge worker (edge/wrangler.toml) ---------------------------------------
# These are NOT read from .env — they live in wrangler.toml [vars] (plaintext
# config) and Cloudflare secrets (sensitive). Documented here for one-stop
# reference:
#   MERCHANT_ROUTES   [vars]  JSON map: proxy hostname -> merchant origin URL
#   DEFAULT_ORIGIN    [vars]  fallback origin ("" = 502 unknown hostnames)
#   INGEST_API_URL    [vars]  base URL of the ingestion service
#   INGEST_API_TOKEN  secret  `npx wrangler secret put INGEST_API_TOKEN`
#                             (same value as INGEST_API_TOKEN above)
